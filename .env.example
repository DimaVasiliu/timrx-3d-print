# TimrX 3D backend example environment
# Copy to .env for local development. Do not commit real secrets.

# Core backend
FLASK_ENV=development
PORT=5001
# Production uses timrx_admin (DML-only, no DDL).
# postgres is reserved for migrations and admin scripts.
DATABASE_URL=postgresql://timrx_admin:pass@localhost:5432/timrx
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Admin auth
ADMIN_TOKEN=replace-with-your-admin-token
# ADMIN_EMAILS=owner@example.com,admin@example.com
# Cloudflare Access (Zero Trust) — verify admin identity JWT at the app layer
# CF_ACCESS_TEAM_DOMAIN=yourteam            # or yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=<application-audience-tag>   # from the Access app's "Application Audience (AUD) Tag"
# Admin brute-force throttle (per-IP failed attempts)
# ADMIN_AUTH_MAX_FAILURES=8
# ADMIN_AUTH_FAIL_WINDOW=300

# Required to use Meshy generation
MESHY_API_KEY=replace-with-your-meshy-key

# Optional AI/image providers
OPENAI_API_KEY=replace-with-your-openai-key
GEMINI_API_KEY=
PIAPI_API_KEY=
BFL_API_KEY=
IDEOGRAM_API_KEY=
RECRAFT_API_KEY=
IMAGE_PROVIDER_GOOGLE_NANO_ENABLED=false
IMAGE_PROVIDER_FLUX_PRO_ENABLED=false
IMAGE_PROVIDER_IDEOGRAM_V3_ENABLED=false
IMAGE_PROVIDER_RECRAFT_V4_ENABLED=false

# Homepage free generation abuse protection
HOMEPAGE_FREE_ENABLED=true
HOMEPAGE_FREE_IMAGE_PROVIDER=nano_banana
HOMEPAGE_FREE_VIDEO_PROVIDER=seedance
HOMEPAGE_FREE_3D_PROVIDER=meshy
HOMEPAGE_FREE_ALLOW_IMAGE=true
HOMEPAGE_FREE_ALLOW_VIDEO=true
HOMEPAGE_FREE_ALLOW_3D=true
HOMEPAGE_FREE_MAX_DAILY_TOTAL=50
HOMEPAGE_FREE_MAX_PER_IP_PER_DAY=6
HOMEPAGE_FREE_MAX_ATTEMPTS_PER_TYPE_PER_DAY=2
HOMEPAGE_FREE_MAX_CREDITS=120
HOMEPAGE_FREE_IMAGE_MAX_CREDITS=12
HOMEPAGE_FREE_VIDEO_MAX_CREDITS=80
HOMEPAGE_FREE_3D_MAX_CREDITS=20
FREE_GENERATION_HASH_SALT=replace-with-a-dedicated-random-secret
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=0x4AAAAAADrAmfltMdgMr9lE
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret
TURNSTILE_EXPECTED_HOSTNAMES=timrx.live,www.timrx.live
TURNSTILE_EXPECTED_ACTION=free_generation

# Optional video provider configuration
VIDEO_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
VERTEX_LOCATION=us-central1

# Optional payments
PAYMENTS_PROVIDER=mollie
MOLLIE_API_KEY=
MOLLIE_PROFILE_ID=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:5001
FRONTEND_BASE_URL=http://localhost:5500

# Optional email / magic code delivery
EMAIL_ENABLED=false
EMAIL_PROVIDER=ses
SES_FROM_EMAIL=
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional storage / uploads
AWS_BUCKET_MODELS=

# Optional webhooks
#
# Meshy webhooks are an OPTIONAL accelerator — polling remains the canonical
# completion path.  Meshy registers webhooks per account in the Meshy dashboard
# (API settings page); it sends no signature header, so the shared secret must
# ride on the URL as ?secret=...  The backend derives that full URL from
# PUBLIC_BASE_URL + MESHY_WEBHOOK_SECRET, e.g.
#   https://3d.timrx.live/api/webhooks/meshy/task?secret=<MESHY_WEBHOOK_SECRET>
# Paste that exact URL into the Meshy dashboard.  Callbacks are rejected when
# MESHY_WEBHOOK_SECRET is empty.
MESHY_WEBHOOK_ENABLED=false
MESHY_WEBHOOK_SECRET=
# Optional: override the derived callback host (default: PUBLIC_BASE_URL)
MESHY_WEBHOOK_URL=
# Optional: also send webhook_url inside each Meshy task payload. Off by
# default — the current Meshy API reference documents no per-task webhook_url.
MESHY_WEBHOOK_SEND_TASK_URL=false
PIAPI_WEBHOOK_ENABLED=false
PIAPI_WEBHOOK_SECRET=
